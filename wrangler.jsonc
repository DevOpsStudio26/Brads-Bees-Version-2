// Cloudflare Workers config for Brad's copy of the site (Railway uses server.js instead).
// Deploy with: npm run deploy:cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brads-bees",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Lets the Worker use Node's Buffer for photo attachments
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any other page loads the React app, which handles the route itself
    "not_found_handling": "single-page-application",
    // Only form submissions wake the Worker; everything else is served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO_EMAIL": "bradbessetti@gmail.com"
  },
  // Saved orders and contact requests for the admin page (/admin).
  // Create the real database once with: npx wrangler d1 create brads-bees
  // then paste the database_id it prints here. Local testing works without it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brads-bees",
      "database_id": "REPLACE_WITH_ID_FROM_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  // Photos customers attach to the contact form.
  // Create the real bucket once with: npx wrangler r2 bucket create brads-bees-photos
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "brads-bees-photos" }],
  "observability": { "enabled": true }
}
