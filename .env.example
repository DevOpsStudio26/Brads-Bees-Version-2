# Copy this file to .env for local testing. Never commit the real .env.
# On Railway, add these under the service's Variables tab instead.

# From resend.com > API Keys
RESEND_API_KEY=

# Where form submissions are emailed
CONTACT_TO_EMAIL=bradbessetti@gmail.com

# Print emails to the terminal instead of sending them (local testing only)
EMAIL_DRY_RUN=true

# Where `npm run dev` sends /api requests. Leave unset to use the Cloudflare
# Worker (npm run worker). Set to http://localhost:3001 to use npm run server.
# API_TARGET=http://localhost:3001
